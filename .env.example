# InvestPilot AI 2.0 Environment Configuration
# Node & Application
NODE_ENV=production
PORT=3000

# SQLite Database (Production can configure PostgreSQL)
DATABASE_URL="file:./data/investpilot.db"

# Market Data Providers (Optional API Keys)
# Fallback to verified local NSE EOD feeds if omitted
YAHOO_FINANCE_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# Broker Gateway Credentials (Configured dynamically in UI / Secrets Vault)
# Zerodha Kite Connect
ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""

# Angel One SmartAPI
ANGEL_ONE_API_KEY=""
ANGEL_ONE_CLIENT_CODE=""
ANGEL_ONE_PIN=""

# Upstox
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
