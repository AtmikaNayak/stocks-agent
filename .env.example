# InvestPilot AI 2.0 — Environment Configuration
# Copy to .env and fill in placeholders locally. NEVER commit a real .env file.
# This template contains placeholders only; no secret is valid as shipped.

# ---------------------------------------------------------------------------
# Node & Application
# ---------------------------------------------------------------------------
# NODE_ENV is intentionally NOT set here.
# Let the tooling choose it for the command you run:
#   npm run dev   -> development (plain-HTTP localhost works)
#   npm test      -> test
#   npm run build / npm start, Dockerfile, docker-compose -> production
# Setting NODE_ENV=production in a local .env silently switches on production-only
# behaviour (Secure cookies) and breaks http://localhost sign-in.
PORT=3000

# Relative path to the SQLite file. Tests point this at an isolated database.
# @example INVESTPILOT_DB_PATH=./data/investpilot.db
INVESTPILOT_DB_PATH=./data/investpilot.db

# SQLite Database (Production can configure PostgreSQL)
DATABASE_URL="file:./data/investpilot.db"

# ---------------------------------------------------------------------------
# Authentication (REQUIRED in production)
# ---------------------------------------------------------------------------
# Session cookies are signed with this secret. Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# There is no default and there is no production fallback: if it is missing or
# shorter than 32 characters while NODE_ENV=production, authentication is
# disabled (login returns 503, every session is rejected).
# Required in production; optional in development (a per-process random secret
# is generated there, which invalidates sessions on every restart).
INVESTPILOT_SESSION_SECRET=""

# Session lifetime in seconds (optional; default 28800 = 8 hours,
# clamped to 300..604800).
#
# Cookies are always HttpOnly, SameSite=Lax and Path=/. `Secure` is added
# whenever NODE_ENV=production, so a production deployment MUST be served over
# HTTPS — otherwise the browser never stores the cookie and sign-in appears to
# fail. For plain-HTTP work on http://localhost use `npm run dev` (development),
# which omits `Secure`.
# INVESTPILOT_SESSION_TTL_SECONDS=28800

# ---------------------------------------------------------------------------
# System operator privileges
# ---------------------------------------------------------------------------
# Comma-separated list of EXACT user IDs allowed to trigger background jobs and
# global agent scans (POST /api/system, POST /api/agents). Empty by default:
# no signed-in user has operator privileges until one is added here.
# Roles are only ever read from the verified session's user id — never from a
# request body, query parameter or header.
# Example (an id from the `users` table):
# INVESTPILOT_SYSTEM_ADMIN_USER_IDS="usr_pilot_01"
INVESTPILOT_SYSTEM_ADMIN_USER_IDS=""

# ---------------------------------------------------------------------------
# Sign-in throttling
# ---------------------------------------------------------------------------
# Failed sign-ins allowed per normalized email, and the reset window in
# seconds. Defaults: 10 failures / 900s (15 min). Clamped to 3..100 and
# 60..86400. Counters are in-process, so this control is single-instance only.
# INVESTPILOT_LOGIN_MAX_FAILURES=10
# INVESTPILOT_LOGIN_WINDOW_SECONDS=900

# Trust a reverse proxy's client-IP header. Leave unset/false unless the proxy
# is configured to OVERWRITE the header on every request; otherwise any client
# can forge it. When disabled (the default) throttling keys on the email only.
# INVESTPILOT_TRUST_PROXY=false
# INVESTPILOT_TRUSTED_PROXY_HEADER="x-forwarded-for"

# Credential provisioning (used only by `npm run auth:set-password`, never by
# the running server). The account must already exist; no user is created and
# no password is stored in source control.
# INVESTPILOT_ADMIN_EMAIL="you@example.com"
# INVESTPILOT_ADMIN_PASSWORD="a-long-unique-passphrase-min-12-chars"

# ---------------------------------------------------------------------------
# Data provenance / provider trust
# ---------------------------------------------------------------------------
# Trust is default-deny. A quote is only "verified/actionable" when its
# freshness is LIVE, DELAYED_15M or EOD *and* its provider string is an exact,
# case-sensitive match for an entry below. Unknown, mistyped or lookalike
# sources stay unverified and non-actionable.
#
# Both lists are EMPTY by default. This repository ships synthetic demo
# fixtures and no real exchange feed, so leaving them empty is correct.
# Comma-separated, exact strings (letters, digits, space, . _ : + -).
# INVESTPILOT_TRUSTED_QUOTE_PROVIDERS=""
# INVESTPILOT_TRUSTED_FUNDAMENTAL_SOURCES=""

# Market Data Providers (optional API keys).
# NOTE: no adapter in this repository consumes these keys yet. There is no
# verified NSE/BSE feed fallback; all shipped prices are seeded demo fixtures.
YAHOO_FINANCE_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# ---------------------------------------------------------------------------
# Broker Gateway Credentials (placeholders — live trading is disabled)
# No broker adapter, order router or fill reconciliation exists in this build.
# Do not enter real credentials.
# ---------------------------------------------------------------------------
# Zerodha Kite Connect
ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""

# Angel One SmartAPI
ANGEL_ONE_API_KEY=""
ANGEL_ONE_CLIENT_CODE=""
ANGEL_ONE_PIN=""

# Upstox
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
